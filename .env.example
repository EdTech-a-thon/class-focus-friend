# Copy to .env.local for local development.
# This file contains no secrets and is safe to commit.

# Where the browser talks to PocketBase. Leave this blank (or unset) to use the
# same address as the website itself, which is what the local dev server and the
# deployed site both do. Set it only when PocketBase lives somewhere else.
VITE_POCKETBASE_URL=

# Where the dev server forwards those account requests. Another project on this
# machine already uses PocketBase's usual 8090, so this one runs on 8091.
POCKETBASE_LOCAL_URL=http://127.0.0.1:8091
